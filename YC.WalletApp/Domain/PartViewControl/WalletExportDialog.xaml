<UserControl x:Class="YC.WalletApp.Domain.WalletExportDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:domain="clr-namespace:YC.WalletApp.Domain"
             xmlns:app="clr-namespace:YC.WalletApp"
             xmlns:local="clr-namespace:YC.WalletApp.Extension"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:system="clr-namespace:System;assembly=mscorlib"
             xmlns:wpf="clr-namespace:MaterialDesignThemes.Wpf;assembly=MaterialDesignThemes.Wpf"
             d:DesignHeight="600"
             d:DesignWidth="400"
             mc:Ignorable="d">
    <Grid Margin="16" MinHeight="500" MinWidth="400">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Grid.Row="0"
                   FontSize="18"
                   FontWeight="Bold"
                   Foreground="#333"
                   Text="{Binding [SelectWalletForExport], Source={x:Static local:LanguageManager.Instance}}"/>

        <!-- 最终对齐修复的TreeView -->
        <Border Grid.Row="1"
                Margin="0"
                Padding="8"
                Background="{DynamicResource MaterialDesignPaper}"
                CornerRadius="4">
            <TreeView x:Name="ExportTreeView"
                        ItemsSource="{Binding Wallets}"
                        BorderThickness="0"
                        MinHeight="300"
                        MaxHeight="400"
                        ScrollViewer.VerticalScrollBarVisibility="Auto">
                <TreeView.Resources>
                    <!-- 钱包模板 -->
                    <HierarchicalDataTemplate DataType="{x:Type app:WalletDto}" 
                                            ItemsSource="{Binding Accounts}">
                        <Grid VerticalAlignment="Center" Height="40">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- 复选框 -->
                            <CheckBox Grid.Column="0"
                                    VerticalAlignment="Center"
                                    VerticalContentAlignment="Center"
                                    HorizontalAlignment="Left"
                                    Margin="0,0,8,0"
                                    IsChecked="{Binding IsSelected}"
                                    Style="{StaticResource MaterialDesignCheckBox}"/>

                            <!-- 钱包图标 -->
                            <wpf:PackIcon Grid.Column="1"
                                        Kind="Wallet" 
                                        Width="20"
                                        Height="20"
                                        VerticalAlignment="Center"
                                        HorizontalAlignment="Left"
                                        Margin="0,0,8,0"
                                        Foreground="{DynamicResource SecondaryHueMidForegroundBrush}"/>

                            <!-- 钱包名称 -->
                            <TextBlock Grid.Column="2"
                                     Text="{Binding WalletName}"
                                     FontSize="14"
                                     VerticalAlignment="Center"
                                     Padding="0,1,0,0"
                                     FontWeight="SemiBold"/>
                        </Grid>
                    </HierarchicalDataTemplate>

                    <!-- 账户模板（精确对齐版本） -->
                    <DataTemplate DataType="{x:Type app:WalletAccountDto}">
                        <Grid VerticalAlignment="Center" Height="36">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- 复选框 -->
                            <CheckBox Grid.Column="0"
                                    VerticalAlignment="Center"
                                    VerticalContentAlignment="Center"
                                    HorizontalAlignment="Left"
                                    Margin="0,0,8,0"
                                    IsChecked="{Binding IsSelected}"
                                    Style="{StaticResource MaterialDesignCheckBox}"/>

                            <!-- 公钥图标 -->
                            <wpf:PackIcon Grid.Column="1"
                                        Kind="Key" 
                                        Width="18"
                                        Height="18"
                                        VerticalAlignment="Center"
                                        HorizontalAlignment="Left"
                                        Margin="0,0,8,0"
                                        Foreground="{DynamicResource SecondaryHueMidForegroundBrush}"/>

                            <!-- 账户信息 -->
                            <StackPanel Grid.Column="2"
                                      VerticalAlignment="Center"
                                      Margin="0,-1,0,0">
                                
                                <TextBlock Text="{Binding PublicKey}"
                                         FontSize="11"
                                         Foreground="{DynamicResource MaterialDesignBodyLight}"
                                         VerticalAlignment="Center"
                                         Padding="0,1,0,0"/>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </TreeView.Resources>

                <!-- 树节点样式 -->
                <TreeView.ItemContainerStyle>
                    <Style TargetType="{x:Type TreeViewItem}" 
                         BasedOn="{StaticResource MaterialDesignTreeViewItem}">
                        <Setter Property="IsExpanded" Value="False"/>
                        <Setter Property="Margin" Value="4,2"/>
                        <Setter Property="VerticalContentAlignment" Value="Center"/>
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>

                        <!-- 自动展开选中项 -->
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter Property="IsExpanded" Value="True"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TreeView.ItemContainerStyle>
            </TreeView>
        </Border>

        <!-- 操作按钮 -->
        <StackPanel Grid.Row="2"
                    Margin="0,24,0,0"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button Command="{x:Static wpf:DialogHost.CloseDialogCommand}"
                    Style="{StaticResource MaterialDesignRaisedButton}"
                    Background="{DynamicResource SecondaryHueMidBrush}"
                    Foreground="White"
                    Content="{Binding [Export], Source={x:Static local:LanguageManager.Instance}}">
                <Button.CommandParameter>
                    <system:Boolean>True</system:Boolean>
                </Button.CommandParameter>
            </Button>
            <Button Margin="16,0,0,0"
                    Command="{x:Static wpf:DialogHost.CloseDialogCommand}"
                    Style="{StaticResource MaterialDesignOutlinedButton}"
                    Content="{Binding [Close], Source={x:Static local:LanguageManager.Instance}}">
                <Button.CommandParameter>
                    <system:Boolean>False</system:Boolean>
                </Button.CommandParameter>
            </Button>
        </StackPanel>
    </Grid>
</UserControl>