<Window x:Class="YC.WalletApp.Views.CustomMessageBox"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Custom MessageBox" Height="200" Width="350"
        WindowStyle="None"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner">
    <Grid Background="White">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <!-- 标题 -->
        <TextBlock Text="{Binding Title}" Foreground="Black" FontSize="18" FontWeight="Bold" Margin="10" HorizontalAlignment="Center"/>
        <!-- 消息内容 -->
        <TextBlock Text="{Binding Message}" Foreground="Black" FontSize="14" Margin="10" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        <!-- 按钮容器 -->
        <StackPanel Orientation="Horizontal" Grid.Row="2" HorizontalAlignment="Center" Margin="10">
            <Button Content="确定" Width="80" Height="30" Margin="5"
                    Background="#007BFF" Foreground="White"
                    Command="{Binding OkCommand}" />
            <Button Content="取消" Width="80" Height="30" Margin="5"
                    Background="#6C757D" Foreground="White"
                    Command="{Binding CancelCommand}" />
        </StackPanel>
    </Grid>
</Window>