<Window x:Class="YC.WalletApp.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:localControl="clr-namespace:YC.WalletApp.Controls"
        xmlns:localView="clr-namespace:YC.WalletApp.Views"
        xmlns:localViewModels="clr-namespace:YC.WalletApp.ViewModels"
        xmlns:localExtension="clr-namespace:YC.WalletApp.Extension"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:system="clr-namespace:System;assembly=mscorlib"
        mc:Ignorable="d" 
        xmlns:models="clr-namespace:YC.ApplicationService;assembly=YC.ApplicationService"
        xmlns:prism="http://prismlibrary.com/"
        prism:ViewModelLocator.AutoWireViewModel="True"
        Title="{Binding [AppTitle], Source={x:Static localExtension:LanguageManager.Instance}}" Height="900" Width="1600" WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <DataTemplate x:Key="PopupContent">
            <StackPanel Margin="8" Orientation="Horizontal"  HorizontalAlignment="Center"
                MinWidth="50">
                <Image Source="{Binding Logo}" Width="18" Height="20" Margin="5 -2"/>
                <TextBlock Text="{Binding Name}"  HorizontalAlignment="Center"/>
            </StackPanel>
        </DataTemplate>
        <localExtension:LocalizationConverter x:Key="NetworkTextConverter"/>
        <DataTemplate DataType="{x:Type system:DateTime}">
            <StackPanel Margin="16" Width="400" Height="300">
                <TextBlock Text="England win the World Cup:" />
                <TextBlock Margin="0,8,0,0" Text="{Binding}" />
                <TextBlock Margin="0,8,0,0" Text="You will never see that again." />
                <Button Margin="0,8,0,0"
              Command="{x:Static materialDesign:DialogHost.CloseDialogCommand}"
              Content="AWESOME"
              IsDefault="True"
              Style="{StaticResource MaterialDesignFlatButton}" />
            </StackPanel>
        </DataTemplate>

    </Window.Resources>
    <Grid>
        <materialDesign:DialogHost DialogTheme="Inherit"
                            Identifier="RootDialog" 
                            SnackbarMessageQueue="{Binding ElementName=MainSnackbar, Path=MessageQueue}" >
            <materialDesign:DialogHost DialogTheme="Inherit"
                    Identifier="SecondDialog" 
                    SnackbarMessageQueue="{Binding ElementName=MainSnackbar, Path=MessageQueue}" >
                <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="80"/>
                    <RowDefinition/>
                </Grid.RowDefinitions>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="5*"/>

                </Grid.ColumnDefinitions>

                <TextBlock x:Name="localNet"  FontWeight="Bold" FontSize="20" Foreground="#3DD0FB" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock.Text>
                        <MultiBinding Converter="{StaticResource NetworkTextConverter}">
                            <Binding Path="[LocalNetWork]" Source="{x:Static localExtension:LanguageManager.Instance}"/>
                            <Binding  Path="CurrentWalletNetWork"/>
                        </MultiBinding>
                    </TextBlock.Text>

                </TextBlock>

                <UniformGrid Columns="2" Grid.Column="1" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Margin="15 0 0 0">
                        <!--<TextBlock Text="🔍" FontSize="18" Foreground="#959595" VerticalAlignment="Center"/>
                        <TextBlock Text="查找" Foreground="#959595" VerticalAlignment="Center" Margin="10 0 0 0" FontSize="15"/>-->
                    </StackPanel>

                    <StackPanel HorizontalAlignment="Right" Margin="0 0 15 0">
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <!--<Button Content="aaa" Click="ShowCustomMessageBoxButton_Click"></Button>-->
                            <ComboBox x:Name="cbb_changeNet" StaysOpenOnEdit="True" VerticalAlignment="Top" ItemsSource="{Binding WalletNetworks}" SelectedItem="{Binding WalletNetwork}" SelectedValuePath="Cluster"
                    SelectionChanged="cbb_changeNetWork_SelectionChanged" 
                    Height="30" Margin="0 10 5 0" DisplayMemberPath="Name"  HorizontalAlignment="Center" HorizontalContentAlignment="Center"
                    MinWidth="170">
                            </ComboBox>
                            <materialDesign:SplitButton VerticalAlignment="Bottom" x:Name="sbtn_1"
                    Content="{Binding CurrentLanguage.Name, FallbackValue=请选择语言}"
                    Style="{StaticResource MaterialDesignRaisedLightSplitButton}"
                    HorizontalAlignment="Center" HorizontalContentAlignment="Center"
                    MinWidth="50" Height="30" Command="{Binding GenreDropDownMenuItemCommand}">
                                <materialDesign:SplitButton.PopupContent>
                                    <ListBox ItemsSource="{Binding Source={x:Static models:DefaultConfig.SupportedLanguages }}"
                      SelectedItem="{Binding CurrentLanguage}" SelectionChanged="lb_changeLanguage_SelectionChanged"
                      ItemTemplate="{StaticResource PopupContent}" />
                                </materialDesign:SplitButton.PopupContent>
                            </materialDesign:SplitButton>
                            <!--<Image Source="../Assets/Images/logo.png" Width="40" Height="40" Stretch="Fill">
                        <Image.Clip>
                            <EllipseGeometry RadiusX="20" RadiusY="20" Center="20,20"/>
                        </Image.Clip>
                    </Image>

                    <TextBlock Text="&#xe62f;" Foreground="#959595" FontSize="24" Margin="15 0 0 0" VerticalAlignment="Center" FontFamily="../Assets/Fonts/#iconfont"  />
                    <TextBlock Text="&#xea97;" Foreground="#959595" FontSize="26" Margin="15 0 15 0" VerticalAlignment="Center" FontFamily="../Assets/Fonts/#iconfont"  />
                    <TextBlock Text="&#xe607;" Foreground="#959595" FontSize="22" VerticalAlignment="Center" FontFamily="../Assets/Fonts/#iconfont"  />-->
                        </StackPanel>
                    </StackPanel>
                </UniformGrid>

                <StackPanel Grid.Row="1">
                    <StackPanel Grid.Column="1" Margin="40 10 0 10" Orientation="Horizontal">
                        <Image Source="../Assets/Images/logo.png" Width="40" Height="40" Stretch="Fill">
                            <Image.Clip>
                                <EllipseGeometry RadiusX="20" RadiusY="20" Center="20,20"/>
                            </Image.Clip>
                        </Image>

                        <StackPanel  HorizontalAlignment="Center" Margin="5 0 0 0">
                            <TextBlock Text="{Binding [Nick Name], Source={x:Static localExtension:LanguageManager.Instance}}" Foreground="#4F5050"/>
                            <TextBlock Text="{Binding User.Name}" FontSize="20" Foreground="#959595"/>
                        </StackPanel>
                    </StackPanel>
                    <localControl:MenuControl />
                    <!--<Button Width="200" Height="40" Margin="30 20 20 0" VerticalAlignment="Bottom" HorizontalAlignment="Left" Content="Add Project" Background="#3DD0FB" BorderBrush="#3DD0FB"  Foreground="White" FontSize="16"/>-->
                </StackPanel>

                <!-- 内容页面局部-->
                <Grid Grid.Row="1" Grid.Column="1" Background="#F5F6FA" >
                    <!-- 添加UserControl到局部 -->
                    <TabControl HorizontalContentAlignment="Left"
          ItemsSource="{Binding  Tabs.CustomTabs}" x:Name="Tabs"
          SelectedItem="{Binding Tabs.SelectedTab}"
          materialDesign:ColorZoneAssist.Background="{DynamicResource MaterialDesignCardBackground}"
          materialDesign:ColorZoneAssist.Foreground="{DynamicResource PrimaryHueMidBrush}"
          materialDesign:ColorZoneAssist.Mode="Custom"
          Style="{StaticResource MaterialDesignFilledTabControl}">
                        <!--
  If you use DisplayMemberPath to bind to a simple auto property you can cause a binking leak.
  See: https://blog.jetbrains.com/dotnet/2014/09/04/fighting-common-wpf-memory-leaks-with-dotmemory/
-->
                        <TabControl.ItemTemplate >
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding CustomHeader}" />
                                    <Button Command="{Binding CloseCommand}">
                                        <Button.Template>
                                            <ControlTemplate>
                                                <materialDesign:PackIcon Kind="Close"
                                     Foreground="Red"
                                     Background="Transparent" />
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </StackPanel>
                            </DataTemplate>
                        </TabControl.ItemTemplate>
                        <TabControl.ContentTemplate>
                            <DataTemplate DataType="ViewModels:CustomTab">
                                <UniformGrid>
                                    <ContentControl Content="{Binding CustomContent}"   Margin="10" />
                                </UniformGrid>
                            </DataTemplate>
                        </TabControl.ContentTemplate>
                    </TabControl>
                    <!--  <local:UserControl1 Margin="10"/> -->

                </Grid>

                <materialDesign:Snackbar x:Name="MainSnackbar"
                 Grid.Row="1"
                 MessageQueue="{materialDesign:MessageQueue}" />

            </Grid>
            </materialDesign:DialogHost>
        </materialDesign:DialogHost>

    </Grid>
</Window>
