                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    --> 
            <!-- Row 1 --><!--
                    <TextBlock Text="姓名：" Grid.Row="0" Grid.Column="0" Margin="5 10"/>
                            <TextBox Grid.Row="0" Grid.Column="1" Margin="5" materialDesign:HintAssist.Hint="请输入用户名"/>
                           
                            <TextBlock Text="性别：" Grid.Row="0" Grid.Column="2" Margin="5 10"/>
                    <TextBox Grid.Row="0" Grid.Column="3" Margin="5"/>

                   
                </Grid>
            </StackPanel>
            </materialDesign:ColorZone>
                <Button Content="{Binding [Submit], Source={x:Static localExtension:LanguageManager.Instance}}" Margin="15" Click="Submit_Click" Visibility ="{Binding IsValidated}"></Button>
