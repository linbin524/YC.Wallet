                    <TextBlock Text="姓名：" Grid.Row="0" Grid.Column="0" Margin="5 30"/>
                    <TextBox x:Name="Name" Grid.Row="0" Grid.Column="1" Margin="5 20"
          materialDesign:HintAssist.Hint="Your name here"   materialDesign:HintAssist.HelperText="Helper text longer than error">
                                <TextBox.Text>
                                    <Binding Path="Name" UpdateSourceTrigger="LostFocus">
                            <Binding.ValidationRules>
                                    <domain:NotEmptyValidationRule  ValidatesOnTargetUpdated="True" />
                                    <domain:EmailValidationRule  ValidatesOnTargetUpdated="True"/>
                            </Binding.ValidationRules>
                        </Binding>
                             </TextBox.Text>
                            </TextBox>
                    <TextBlock Text="性别：" Grid.Row="0" Grid.Column="2" Margin="5 30"/>
                    <TextBox x:Name="UserName1" Grid.Row="0" Grid.Column="3" Margin="5 20"
materialDesign:HintAssist.Hint="Your name here">
