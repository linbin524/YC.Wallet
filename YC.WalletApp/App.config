<?xml version="1.0" encoding="utf-8"?>
<configuration>
    <startup> 
        <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8"/>
    </startup>

	<connectionStrings>
		<add name="SQLiteConnection"
			 connectionString="Data Source=wallet.db;Pooling=true;Min Pool Size=10"
			 providerName="System.Data.SQLite.SQLiteFactory"/>
	</connectionStrings>
</configuration>
